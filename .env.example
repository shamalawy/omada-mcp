# --- Required -------------------------------------------------------------
# "Interface Access Address" of your Open API app (Settings > Platform Integration > Open API > View).
# Local controller example: https://192.168.0.10:8043   Cloud example: https://use1-omada-northbound.tplinkcloud.com
OMADA_BASE_URL=https://192.168.0.10:8043
OMADA_CLIENT_ID=
OMADA_CLIENT_SECRET=

# --- Usually needed --------------------------------------------------------
# Omada ID of the app (MSP ID for MSP apps). Local controllers: auto-detected if left empty.
OMADA_ID=
# Local controllers use a self-signed certificate: set to false.
OMADA_VERIFY_SSL=true

# --- Optional --------------------------------------------------------------
# Authorization-code mode (act as a controller user). Leave empty for client-credentials mode.
OMADA_USERNAME=
OMADA_PASSWORD=
# Default site (name or ID) for operations that need {siteId}.
OMADA_SITE=
# Only allow GET operations.
OMADA_READ_ONLY=false
# meta = 7 tools that reach every operation (default); full = also one tool per operation.
OMADA_TOOL_MODE=meta
# Filters (apply to both modes). Tags are comma-separated; operations are a regex on operationId.
OMADA_INCLUDE_TAGS=
OMADA_EXCLUDE_TAGS=
OMADA_INCLUDE_OPERATIONS=
OMADA_EXCLUDE_OPERATIONS=
OMADA_EXCLUDE_DEPRECATED=false
# Expose omada_request (raw HTTP; not limited by the filters above).
OMADA_ALLOW_RAW_REQUEST=true
# auto (controller's live spec, fall back to bundled) | live | bundled | /path/to/spec.json
OMADA_SPEC=auto
OMADA_TIMEOUT_MS=30000
OMADA_MAX_RESPONSE_CHARS=100000

# --- Transport -------------------------------------------------------------
# stdio (default) or http (Streamable HTTP at /mcp)
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3000
# Require "Authorization: Bearer <token>" on /mcp. Strongly recommended if not bound to 127.0.0.1.
MCP_HTTP_TOKEN=
